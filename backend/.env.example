# Google Cloud / Vertex AI configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=europe-west1
GEMINI_MODEL=gemini-2.5-flash

# Backend server configuration
PORT=8000
HOST=0.0.0.0
